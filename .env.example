# Copie para .env e ajuste conforme necessário. Nunca versione o .env real.
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
CURATED_DATA_DIR=data/curated
GOLD_DATA_DIR=data/gold
QUALITY_DATA_DIR=data/quality
LOG_LEVEL=INFO

# Kaggle API — https://www.kaggle.com/settings → API → Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=

# Postgres opcional (podman compose up -d). Sem isto, só a saída em Parquet.
# DATABASE_URL=postgresql://etl:etl@localhost:5432/multi_format_etl

# Observabilidade (pipeline-monitoring, ver dags/monitoring_callbacks.py).
# No Airflow o compose sobrescreve DATABASE_PATH para o data/ do projeto.
# MIN_ROWS_EXPECTED=0: callbacks de task não reportam linhas.
DATABASE_PATH=data/monitoring.db
MIN_ROWS_EXPECTED=0
